{
  "name": "gema-farm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js && vite build --config frontend/vite.config.js --ssr src/entry-server.jsx --outDir ../.ssr && node scripts/prerender.js",
    "start": "vite --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js --host 127.0.0.1",
    "format": "prettier --write frontend/src frontend/vite.config.js scripts tests package.json README.md",
    "test": "node --test tests/frontend.test.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^6.1.0"
  }
}
